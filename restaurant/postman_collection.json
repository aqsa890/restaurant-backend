{
  "info": {
    "name": "Restaurant Service - Menu API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Collection to test menu endpoints for the Restaurant service"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:5002"
    }
  ],
  "item": [
    {
      "name": "Create Menu",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Margherita Pizza\",\n  \"price\": 12.99,\n  \"description\": \"Classic cheese & tomato\"\n}"
        },
        "url": { "raw": "{{baseUrl}}/api/menu", "host": ["{{baseUrl}}"], "path": ["api","menu"] }
      }
    },
    {
      "name": "Create Bulk Menus",
      "request": {
        "method": "POST",
        "header": [ { "key": "Content-Type", "value": "application/json" } ],
        "body": {
          "mode": "raw",
          "raw": "[\n  { \"name\": \"Penne Alfredo\", \"price\": 11.5 },\n  { \"name\": \"Caesar Salad\", \"price\": 8.0 }\n]"
        },
        "url": { "raw": "{{baseUrl}}/api/menu/bulk", "host": ["{{baseUrl}}"], "path": ["api","menu","bulk"] }
      }
    },
    {
      "name": "Get All Menus",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/api/menu/get-menu", "host": ["{{baseUrl}}"], "path": ["api","menu","get-menu"] }
      }
    },
    {
      "name": "Get Menu By ID",
      "request": {
        "method": "GET",
        "header": [],
        "url": { "raw": "{{baseUrl}}/api/menu/:id", "host": ["{{baseUrl}}"], "path": ["api","menu",":id"] }
      }
    },
    {
      "name": "Update Menu",
      "request": {
        "method": "PUT",
        "header": [ { "key": "Content-Type", "value": "application/json" } ],
        "body": { "mode": "raw", "raw": "{ \"price\": 13.99 }" },
        "url": { "raw": "{{baseUrl}}/api/menu/update-menu/:id", "host": ["{{baseUrl}}"], "path": ["api","menu","update-menu",":id"] }
      }
    },
    {
      "name": "Delete Menu",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": { "raw": "{{baseUrl}}/api/menu/delete-menu/:id", "host": ["{{baseUrl}}"], "path": ["api","menu","delete-menu",":id"] }
      }
    }
  ]
}
